# =============================================================================
# Arabic Graph RAG — Environment Configuration
# Copy this file to `.env` and fill in the values before running the project.
# =============================================================================

# -----------------------------------------------------------------------------
# Ollama Cloud (ALL LLM inference goes through this — no local LLM required)
# -----------------------------------------------------------------------------
# Get an API key at https://ollama.com  (Settings -> API Keys) after enabling
# Ollama Cloud on your account.
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Base host for the Ollama Cloud REST API (OpenAI/Ollama-compatible).
OLLAMA_HOST=https://ollama.com

# Default chat/completion model served by Ollama Cloud. Any cloud model can be
# used here (e.g. qwen2.5:latest, llama3.1:70b, deepseek-r1:latest, etc.)
OLLAMA_MODEL=qwen2.5:latest

# Optional: a cheaper/faster model used for lightweight sub-tasks (query
# rewriting, decomposition, self-query parsing, routing). Falls back to
# OLLAMA_MODEL if left empty.
OLLAMA_FAST_MODEL=

# Request timeout (seconds) and retry settings for the Ollama Cloud client.
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Sampling defaults
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=1024

# Approximate cost per 1K tokens (USD) used ONLY for local cost estimation/
# tracking in reports. Ollama Cloud pricing may differ — adjust as needed.
COST_PER_1K_PROMPT_TOKENS=0.0
COST_PER_1K_COMPLETION_TOKENS=0.0

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Backend selector: "local" (fastembed, downloaded once and cached — default)
# or "huggingface" (remote Hugging Face Inference API, no local download).
# Switching this is the ONLY change needed to move between backends.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_CACHE_DIR=./data/model_cache
EMBEDDING_BATCH_SIZE=32

# Hugging Face Inference API settings (only used when EMBEDDING_PROVIDER=huggingface).
# Get a token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL_ID=intfloat/multilingual-e5-large
HF_TIMEOUT=120

# -----------------------------------------------------------------------------
# Reranker (local, multilingual cross-encoder — ONNX runtime, no torch needed)
# -----------------------------------------------------------------------------
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANKER_CACHE_DIR=./data/model_cache
RERANKER_TOP_K=5

# -----------------------------------------------------------------------------
# ChromaDB (local persistent vector store)
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=arabic_graph_rag

# -----------------------------------------------------------------------------
# Chunking
# -----------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=40

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=8
DENSE_TOP_K=15
BM25_TOP_K=15
RRF_K=60
HYBRID_ALPHA=0.5

# -----------------------------------------------------------------------------
# GraphRAG
# -----------------------------------------------------------------------------
GRAPH_STORE_DIR=./data/graph
GRAPH_STORE_FILE=knowledge_graph.json
GRAPH_EXPANSION_HOPS=1
GRAPH_MAX_NEIGHBORS=8
GRAPH_MIN_ENTITY_LEN=2

# -----------------------------------------------------------------------------
# CRAG (Corrective RAG)
# -----------------------------------------------------------------------------
CRAG_RELEVANCE_THRESHOLD=0.55
CRAG_MAX_CORRECTIVE_QUERIES=2

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_DIR=./logs
LOG_FILE=pipeline.jsonl
LOG_LEVEL=INFO
CONSOLE_LOG=true

# -----------------------------------------------------------------------------
# Evaluation / Reports
# -----------------------------------------------------------------------------
REPORTS_DIR=./reports
EVAL_DATASET=./data/eval/eval_questions.json

# -----------------------------------------------------------------------------
# Data
# -----------------------------------------------------------------------------
PDF_DIR=./data/pdfs
